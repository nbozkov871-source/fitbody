# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# The template carries no secrets and is the only record of which variables
# the app needs, so it is the one .env file that belongs in the repo.
!.env.local.example

# Local Claude Code state: machine paths and permissions, plus vendored
# skills that belong to their authors rather than to this project.
.claude/settings.local.json
.claude/skills/
